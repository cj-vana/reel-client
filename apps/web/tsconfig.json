{
  "compilerOptions": {
    "target": "ES2017", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "useDefineForClassFields": false,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "vite.tv.config.ts", "playwright.config.ts"]
}
