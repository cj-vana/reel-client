# XcodeGen writes these projects. The one tracked file inside is the iOS app's Package.resolved,
# which pins its Swift packages; after changing a package, stage it with `git add -f`.
apps/tvos/*.xcodeproj/
apps/apple/*.xcodeproj/
apps/apple/qa/layout-probe/*.xcodeproj/

